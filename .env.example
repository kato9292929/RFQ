# ---- network (devnet only; never point this at mainnet) ----
CLUSTER=devnet
RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=7XpxowqbuaEbQ3VkuQemFi7B3aMuat7eKtp5kydGvsVp
# Circle devnet USDC
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
FEE_BPS=100

# ---- x402 ----
# Public facilitator used on devnet. Its /supported lists exact on
#   solana-devnet (x402 v1) and solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1 (v2, CAIP-2 of devnet)
#   feePayer CKPKJWNdJEqa81x7CkZ14BVPiY6y16Sxs7owznqtWYp5 (checked 2026-10-09)
FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1
# Local validator runs use the in-repo facilitator instead:
# FACILITATOR_URL=http://127.0.0.1:8790
# FACILITATOR_KEYPAIR=.keys/facilitator.json
# Node's fetch only honours HTTPS_PROXY with this set (needed behind a proxy)
NODE_USE_ENV_PROXY=1

# ---- keys (local files, never committed; .keys/ is gitignored) ----
DEPLOYER_KEYPAIR=.keys/deployer.json
TREASURY_OWNER_KEYPAIR=.keys/treasury_owner.json
BUYER_KEYPAIR=.keys/buyer.json
# per seller process:
# SELLER_KEYPAIR=.keys/seller1.json
# SELLER_OFFERS=agents/seller/offers.seller1.json
# SELLER_PORT=8801
# SELLER_PUBLIC_URL=http://127.0.0.1:8801

# ---- indexer ----
INDEXER_PORT=8787
INDEXER_URL=http://127.0.0.1:8787

# ---- agent tuning ----
SELLER_POLL_MS=60000
SELLER_QUOTE_TTL_SEC=1800
BUYER_MAX_PRICE=100000
BUYER_RFQ_WINDOW_SEC=150
